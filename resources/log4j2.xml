<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="C" target="SYSTEM_OUT">
			<PatternLayout
				pattern="[%c] [%d{dd MMM yyyy - hh:mm:ss}] %5p - %m %n" />
		</Console>
		<RollingFile name="fileappender"
			fileName="${sys:catalina.base}\logs\QPDefender.log"
			filePattern="${sys:catalina.base}\logs\QPDefender.%i.log.gz">
			<PatternLayout
				pattern="[%c] [%d{dd MMM yyyy - hh:mm:ss}] %5p - %m %n" />
			<Policies>
				<SizeBasedTriggeringPolicy size="500kB" />
			</Policies>
			<DefaultRolloverStrategy max="3" />
		</RollingFile>
	</Appenders>
	<Loggers>
		<Root level="info">
			<AppenderRef ref="C" />
			<AppenderRef ref="fileappender" />
		</Root>
	</Loggers>
</Configuration>