<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	version="3.1">

	<display-name>QPStandards</display-name>

	<servlet>
		<description>This sets up our JAX-RS url mapping. Note that the app is used as a 
  			pre-curser to ensure we don't get into a resource infinite loop as noted 
  			below.</description>
		<servlet-name>qpDefender</servlet-name>
		<!-- <servlet-class>com.sun.jersey.spi.container.servlet.ServletContainer</servlet-class> -->
		<servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
		<init-param>
			<description>This parameter is needed to enable security annotation for Jersey 
				within a J2EE container.</description>
			<!-- <param-name>com.sun.jersey.spi.container.ResourceFilters</param-name> -->
			<!-- <param-value>com.sun.jersey.api.container.filter.RolesAllowedResourceFilterFactory</param-value> -->
			<param-name>javax.ws.rs.container.DynamicFeature</param-name>
			<param-value>javax.ws.rs.container.RolesAllowedDynamicFeature</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>

	<!-- This listener class picks up log4j output. See log4j.properties file 
		for appender information -->
	<!-- logger can be called by any class -->
	<listener>
		<listener-class>
			gov.ca.bc.qp.QPDefender.web.ApplicationServletContextListener</listener-class>
	</listener>

	<servlet-mapping>
		<servlet-name>qpDefender</servlet-name>
		<url-pattern>/app/*</url-pattern>
	</servlet-mapping>
	<resource-ref>
		<description>DB Connection Pool</description>
		<res-ref-name>jdbc/QP_Security</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>MyRealm</web-resource-name>
			<description>Security for entire project</description>
			<url-pattern>/app/*</url-pattern>
			<http-method>GET</http-method>
			<http-method>POST</http-method>
			<http-method>PUT</http-method>
			<http-method>DELETE</http-method>
		</web-resource-collection>
		<auth-constraint>
			<description>Allow all roles access to our security-domain. Let the annotations
				within the classes take care of restrictions.</description>
			<role-name>*</role-name>
		</auth-constraint>
	</security-constraint>
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>MyRealm Restricted</web-resource-name>
			<description>Security for entire project Restrictions</description>
			<url-pattern>/app/*</url-pattern>
			<http-method-omission>GET</http-method-omission>
			<http-method-omission>POST</http-method-omission>
			<http-method-omission>PUT</http-method-omission>
			<http-method-omission>DELETE</http-method-omission>
		</web-resource-collection>
		<auth-constraint>
			<description>Allow all roles access to our security-domain. Explicit restrictions.</description>
			<role-name>*</role-name>
		</auth-constraint>
	</security-constraint>	
	
	<login-config>
		<auth-method>QP</auth-method>
		<form-login-config>
			<form-login-page>/logon.jsp</form-login-page>
			<form-error-page>/logonError.jsp</form-error-page>
		</form-login-config>
	</login-config>
	<security-role>
		<role-name>qpadmin</role-name>
	</security-role>
	<security-role>
		<role-name>security.group.admin</role-name>
	</security-role>
	<security-role>
		<role-name>security.user</role-name>
	</security-role>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

</web-app>