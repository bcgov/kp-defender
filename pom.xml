<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ca.bc.gov.qp</groupId>
	<artifactId>QPDefender</artifactId>
	<version>1.0.2</version>
	<packaging>war</packaging>

	<properties>
		<deploy_context>dev</deploy_context>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<build>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>resources</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<!-- qp-deploy-mavn-plugin controls rolling backups, etc. -->
				<!-- Notice it is bound to 'package' phase for deployment. -->
				<groupId>ca.bc.gov.qp</groupId>
				<artifactId>qp-deploy-maven-plugin</artifactId>
				<version>1.0.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>rollingBackup</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<filePath>${project.build.directory}\${project.artifactId}.war</filePath>
					
					<deploymentPath>${deployment.server.name}\Applications\testbuilds</deploymentPath>
					<!-- uncomment below to set higher or lower number of backups to keep. 
						(defaults to 3) -->
					<!-- <maxBackups>4</maxBackups> -->
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>11</source>
					<target>11</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<warSourceDirectory>WebContent</warSourceDirectory>
					<warName>${project.artifactId}</warName>
					<failOnMissingWebXml>false</failOnMissingWebXml>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.12.4</version>
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<dependencies>
