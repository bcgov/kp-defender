<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

	<xsd:include schemaLocation="product.xsd"/>

	<xsd:element name="groupProduct" type="groupProductType"/>

	<xsd:complexType name="groupProductType">
		<xsd:sequence>
			<xsd:element name="id" type="xsd:integer"/>
			<xsd:element name="groupid" type="xsd:integer"/>
			<xsd:element ref="product"/>
			<xsd:element name="concurrent" type="xsd:integer"/>
			<xsd:element name="expiryDate" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>

	
</xsd:schema>