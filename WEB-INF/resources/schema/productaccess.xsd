<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

	<xsd:include schemaLocation="product.xsd"/>
	<xsd:include schemaLocation="roles.xsd"/>

	<xsd:element name="productAccess" type="productAccessType"/>

	<xsd:complexType name="productAccessType">
		<xsd:sequence>
			<xsd:element name="userProductsID" type="xsd:integer"/>
			<xsd:element name="userid" type="xsd:integer"/>
			<xsd:element name="timeout" type="xsd:integer"/>
			<xsd:element name="active" type="xsd:boolean"/>
			<xsd:element name="product" type="productType"/>
			<xsd:element ref="roles"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>